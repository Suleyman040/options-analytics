# Copy to .env to change settings. Every value here is the default.
# docker compose reads the stream settings from .env too.

# --- What to stream ---
CURRENCY=BTC
# Nearest N expiries, strikes within ±25% of spot
MAX_EXPIRIES=4
STRIKE_RANGE=0.25
# 100ms (fast, more data) or agg2 (one update per option every 2 seconds)
TICKER_INTERVAL=100ms

# --- Deribit (swap for test.deribit.com to use the testnet) ---
DERIBIT_REST_URL=https://www.deribit.com/api/v2
DERIBIT_WS_URL=wss://www.deribit.com/ws/api/v2

# --- Services, as seen from your own machine (inside Docker these are overridden) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=app
CLICKHOUSE_PASSWORD=app
CLICKHOUSE_DATABASE=options
POSTGRES_DSN=postgresql://app:app@localhost:5432/options

# --- Processor batching ---
BATCH_SIZE=5000
FLUSH_INTERVAL_S=1.0

LOG_LEVEL=INFO
